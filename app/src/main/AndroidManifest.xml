<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SHARE FILE: kirim file antar HP lewat Wi-Fi atau hotspot -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <application
        android:label="Flashmate"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FlashImgActivity" android:exported="false" />
        <activity android:name=".FlashRomActivity" android:exported="false" />
        <activity android:name=".FlashSettingsActivity" android:exported="false" />
        <activity
            android:name=".AdbSideloadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ShareFileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
