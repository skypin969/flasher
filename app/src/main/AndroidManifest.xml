<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SHARE FILE: kirim file antar HP lewat Wi-Fi Direct (tidak perlu satu jaringan Wi-Fi) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 13 ke atas: izin mencari hp lain tanpa dipakai untuk lokasi -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Android 12 ke bawah: Wi-Fi Direct butuh izin lokasi untuk mencari hp lain -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Aplikasi tetap bisa dipasang di hp yang tidak punya Wi-Fi Direct -->
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <application
        android:label="Flashmate"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FlashImgActivity" android:exported="false" />
        <activity android:name=".FlashRomActivity" android:exported="false" />
        <activity android:name=".FlashSettingsActivity" android:exported="false" />
        <activity
            android:name=".AdbSideloadActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ShareFileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
